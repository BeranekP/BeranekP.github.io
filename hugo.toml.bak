baseurl = "http://www.pberanek.eu"
title = "TototJatoTrava"
theme = "PaperMod"
locale = "en"
defaultcontentlanguage = "en"

[pagination]
  disableAliases = false
  pagerSize = 20
  path = 'page'

[services]
[services.disqus]
disqusShortname = "pberanek"

[markup.highlight]
style = "github-dark"

[params]
  author = "TototJatoTrava"
  info = " "
  description = "TototJatoTrava personal website"
  keywords = ["blog", "personal"]
  avatarurl = "images/photo.png"
  #gravatar = "john.doe@example.com"

  faviconSVG = "/img/favicon.svg"
  favicon_32 = "/img/favicon-32x32.png"
  favicon_16 = "/img/favicon-16x16.png"

  since = 2019

  enableTwemoji = true

  defaultTheme = dark
  colorScheme = "dark"
  hidecolorschemetoggle = false

  [params.profileMode]
    enabled = true
    title = "TototJatoTrava"
    subtitle = "Welcome to my personal website."
    imageTitle = "TototJatoTrava"

  customCSS = ["css/custom.css"]
  # customSCSS = ["scss/custom.scss"]
  customJS = ["js/custom.js"]

[taxonomies]
  category = "categories"
  series = "series"
  tag = "tags"
  author = "authors"

# Social links
[[params.social]]
  name = "Github"
  icon = "fa-brands fa-github fa-2x"
  weight = 1
  url = "https://github.com/BeranekP/"

[[homeInfoParams]]
  Title = "Hi there \U0001F44B"
  content = "Welcome to my blog"


[[main]]
  name = 'About'
  pageRef = '/'
  weight = 10

# Menu links
[menus]
  [[menu.main]]
    name = "Projects"
    weight = 2
    pageRef = "projects/"
  [[menu.main]]
    name = "Travel"
    weight = 1
    pageRef = "travel/"
